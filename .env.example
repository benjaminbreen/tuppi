# Server-side only. Use your existing OpenRouter API key for Jev.
# Add OPENROUTER_API_KEY to Vercel's Environment Variables when deploying.
OPENROUTER_API_KEY=

# Optional direct TypeSafe fallback if no OpenRouter key is set:
# TYPESAFE_API_KEY=

# Optional wording fallback, used only when procedural goal parsing is insufficient.
# Direct OpenAI Responses API: gpt-6-luna with reasoning.effort=none.
# Set the same server-only name in Vercel. Never use a VITE_ prefix.
OPENAI_API_KEY=
