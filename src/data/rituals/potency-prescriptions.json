{
  "id": "potency-prescriptions",
  "cth": 802,
  "title": "Prescriptions for potency",
  "shortName": "Potency prescriptions",
  "eyebrow": "CTH 802 · Babylonian medicine at Ḫattuša",
  "dating": {
    "label": "copied at Ḫattuša, 14th–13th c. BCE",
    "note": "An Akkadian tablet found at Ḫattuša, not in Boğazköy script (probably imported or copied from a Babylonian original). The date is an approximate manuscript date, not a date of composition.",
    "sourceUrl": "https://www.hethport.uni-wuerzburg.de/CTH/"
  },
  "purpose": "Babylonian prescriptions, copied at Ḫattuša, for restoring a man’s sexual potency with dried and crushed animal and plant ingredients, washes, anointing and an incantation.",
  "attribution": "Anonymous Babylonian medical series",
  "sourceSummary": "KUB 4.48 (Bo 4894) obv., rev., left edge",
  "editionUrl": "https://www.hethport.uni-wuerzburg.de/CTH/",
  "editionLabel": "Hethitologie-Portal Mainz, CTH catalogue (see Biggs, TCS 2; Zisa 2021)",
  "phases": [
    {
      "name": "Partridge remedy",
      "range": [
        1,
        5
      ],
      "idea": "A male partridge is caught, killed, salted, dried, crushed and drunk in beer."
    },
    {
      "name": "Water under the stars",
      "range": [
        6,
        8
      ],
      "idea": "Blood-water is left out overnight and drunk at sunrise."
    },
    {
      "name": "Other preparations",
      "range": [
        9,
        15
      ],
      "idea": "Wool bundles, flour mixtures, pellets, washing and anointing."
    },
    {
      "name": "Incantation and closing recipe",
      "range": [
        16,
        17
      ],
      "idea": "A Sumerian incantation and a final partridge decoction."
    }
  ],
