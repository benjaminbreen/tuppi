  "eyebrow": "CTH 406 · procreative power",
  "dating": {
    "label": "Hittite manuscript",
    "note": "The surviving text is transmitted in KUB 7.8 and joined fragments; the date of the rite’s composition is not fixed by this copy.",
    "sourceUrl": "https://smaw.de.dariah.eu/txhet_besrit/intro.php?ed=A.+Mouton&lg=FR&prgr=&xst=CTH+406"
  },
  "purpose": "A three-day rite in which offerings, a passage beneath reed gates and prayers to Uliliyašši seek to restore a man’s procreative power.",
  "attribution": "Attributed to Paškuwatti of Arzawa",
  "sourceSummary": "KUB 7.8+ · selected first-day acts and prayer",
  "editionUrl": "https://smaw.de.dariah.eu/txhet_besrit/intro.php?ed=A.+Mouton&lg=FR&prgr=&xst=CTH+406",
  "phases": [
    {
      "name": "Prepare the offering",
      "range": [
        1,
        2
      ],
      "idea": "Food, wine and garments are assembled and carried into the open country."
    },
    {
      "name": "The gate crossing",
      "range": [
        3,
        8
      ],
      "idea": "The man crosses a reed gate and exchanges implements while Paškuwatti speaks."
    },
    {
      "name": "Petition and return",
      "range": [
        9,
        10
      ],
      "idea": "The god is petitioned and the offerings return to a new table."
    }
  ],
