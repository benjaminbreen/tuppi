{
  "id": "hittite-remedies",
  "cth": 461,
  "title": "Hittite medical remedies",
  "shortName": "Hittite remedies",
  "eyebrow": "CTH 461 · Hittite prescriptions",
  "dating": {
    "label": "New Hittite copies, 13th c. BCE",
    "note": "Both tablets are in New Hittite script; KUB 44.61 is signed by the scribe NU.GIŠKIRI₆, pupil of Ḫulanabi. This is an approximate manuscript date.",
    "sourceUrl": "https://www.hethport.uni-wuerzburg.de/CTH/"
  },
  "purpose": "Hittite medical prescriptions for internal illness, unwell limbs, a discharge and bloating, with graded fallbacks when the first remedy fails.",
  "attribution": "Scribe NU.GIŠKIRI₆, pupil of Ḫulanabi (KUB 44.61); anonymous (KUB 44.64)",
  "sourceSummary": "KUB 44.61 (CTH 461.1) · KUB 44.64 (CTH 461.10)",
  "editionUrl": "https://www.hethport.uni-wuerzburg.de/CTH/",
  "editionLabel": "Hethitologie-Portal Mainz, CTH catalogue (see Burde, StBoT 19; Zubieta Lupo 2017)",
  "phases": [
    {
      "name": "Seven-day herbs",
      "range": [
        1,
        2
      ],
      "idea": "A patient ill inside receives herbs over seven days."
    },
    {
      "name": "Fallback: bulbs in wine",
      "range": [
        3,
        5
      ],
      "idea": "If he does not get well, bulbs are steeped and given for seven days."
    },
    {
      "name": "Limbs: leopard-killed sinew",
      "range": [
        6,
        7
      ],
      "idea": "A root and sinew are sewn and twisted into a leather cord."
    },
    {
      "name": "Discharge: warm compress",
      "range": [
        8,
        8
      ],
      "idea": "A heated compress lies overnight; fallback soaking and lead ointment."
    },
    {
      "name": "Remedies for the stars",
      "range": [
        9,
        12
      ],
      "idea": "Crushed plants are left out overnight for the stars and drunk in the morning."
    },
    {
      "name": "Second-day remedy",
      "range": [
        13,
        14
      ],
      "idea": "Further plants are bagged and given in honey until recovery."
    },
    {
      "name": "Bloating: fish",
      "range": [
        15,
        15
      ],
      "idea": "A gutted fish begins a remedy for bloating."
    }
  ],
