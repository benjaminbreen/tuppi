{
  "name": "tuppi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:rituals && tsc -b && vite build",
    "check:rituals": "node scripts/build-ritual-refs.mjs && node scripts/build-ritual-quotes.mjs && node scripts/check-rituals.mjs && node scripts/check-ritual-semantics.mjs && node scripts/check-corpus-rituals.mjs",
    "test:composer": "node scripts/test-ritual-composer.mjs && node scripts/test-ritual-planning.mjs",
    "preview": "vite preview",
    "data": "python3 scripts/extract.py && python3 scripts/formdict.py && python3 scripts/build.py && python3 scripts/places.py && node scripts/map.mjs && node scripts/apply-cmawro-glosses.mjs",
    "ritual:extract": "node scripts/ritual-extraction.mjs",
    "test:extraction": "node scripts/test-ritual-extraction.mjs",
    "audit:corpora": "node scripts/audit-corpora.mjs",
    "test:wording": "node scripts/test-ritual-wording.mjs",
    "test:execution": "node scripts/test-ritual-execution.mjs",
    "test:vocabulary": "node scripts/test-ritual-vocabulary.mjs",
    "test:participants": "node scripts/test-ritual-participants.mjs",
    "test:expression": "node scripts/test-ritual-expression.mjs",
    "test:speech": "node scripts/test-ritual-speech.mjs",
    "test:grammar": "node scripts/test-ritual-grammar.mjs",
    "images:handoff": "node scripts/build-image-handoff.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/gentium-plus": "^5.3.0",
    "@fontsource/noto-sans-cuneiform": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "d3-geo": "^3.1.1",
    "sane-topojson": "^4.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0",
    "world-atlas": "^2.0.2"
  }
}
